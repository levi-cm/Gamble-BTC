# Bech32 BTC address (bc1...). Coinbase reward lands here if block found.
BTC_ADDRESS=bc1qexampleexampleexampleexampleexampleexample
POOL_URL=stratum+tcp://public-pool.io:3333
WORKER_NAME=cavebox
GBTC_BACKEND=auto
GBTC_PROBE_ONLY=0
GBTC_DEVICE=/dev/dri/renderD128
# Direct/host-network status listener; set 0.0.0.0 only for trusted-LAN access.
GBTC_HTTP_BIND=127.0.0.1
# Compose host-port bind; set 0.0.0.0 only for trusted-LAN access.
GBTC_STATUS_BIND=127.0.0.1
GBTC_BATCH_NONCES=16777216
GBTC_BENCH_ONLY=0
GBTC_BENCH_SECONDS=60
GBTC_BENCH_WARMUP_SECONDS=5
GBTC_GLES_KERNEL=altbool
GBTC_GLES_LOCAL_SIZE=16
GBTC_GLES_AUTOTUNE=0
MESA_NO_ERROR=1
