# Bech32 BTC address (bc1...). Coinbase reward lands here if block found.
BTC_ADDRESS=bc1qexampleexampleexampleexampleexampleexample
POOL_URL=stratum+tcp://public-pool.io:3333
WORKER_NAME=cavebox
# Direct docker-run override only. Compose uses its Tailscale sidecar at
# 127.0.0.1:1055 and requires an authenticated, online Mullvad exit node.
# Pool DNS and TCP connections use this strict proxy chain; no direct fallback.
GBTC_SOCKS5_HOST=
GBTC_SOCKS5_PORT=1080
GBTC_VERIFY_MULLVAD=1
GBTC_EXIT_PRIMARY=max-vprouter.dinosaur-dojo.ts.net
GBTC_EXIT_FALLBACK=nico-vpn.dinosaur-dojo.ts.net
GBTC_BACKEND=opencl
GBTC_PROBE_ONLY=0
# Direct/host-network status listener; set 0.0.0.0 only for trusted-LAN access.
GBTC_HTTP_BIND=0.0.0.0
# Compose host-port bind; set 0.0.0.0 only for trusted-LAN access.
GBTC_STATUS_BIND=127.0.0.1
GBTC_BATCH_NONCES=16777216
GBTC_BENCH_ONLY=0
GBTC_BENCH_SECONDS=60
GBTC_BENCH_WARMUP_SECONDS=5
GBTC_GLES_KERNEL=altbool
GBTC_GLES_LOCAL_SIZE=16
GBTC_GLES_AUTOTUNE=0
# OpenCL backend work-group size: 8, 16, 32, 64, 128, 256, 512, or auto.
GBTC_OPENCL_LOCAL_SIZE=64
# Kernel variant: unrolled, looped, or dual (two nonces per work-item).
GBTC_OPENCL_KERNEL=unrolled
# Requested SIMD/subgroup width: auto, 8, 16, or 32. Emitted as
# intel_reqd_sub_group_size; auto leaves the choice to IGC.
GBTC_OPENCL_SIMD=auto
# Event-poll interval (us) for GPU completion; the feeder thread sleeps here
# instead of spin-burning a CPU core in the driver.
GBTC_OPENCL_POLL_US=1000
# CUDA backend threads per block: 32, 64, 128, 256, or 512.
GBTC_CUDA_BLOCK=64
# Optional OpenCL platform substring override (e.g. rusticl); unset prefers a
# vendor driver (Intel NEO) over Mesa fallback ICDs.
#GBTC_OPENCL_PLATFORM=
MESA_NO_ERROR=1
