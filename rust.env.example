# Rust candidate only. Replace the sample address before real pool use.
BTC_ADDRESS=bc1qexampleexampleexampleexampleexampleexample
POOL_URL=stratum+tcp://public-pool.io:3333
WORKER_NAME=rust-igpu
GBTC_BACKEND=vulkan
GBTC_DEVICE=/dev/dri/renderD128
GBTC_HTTP_BIND=127.0.0.1
GBTC_HTTP_PORT=41176
GBTC_BATCH_NONCES=16777216
GBTC_VULKAN_KERNEL=pre3
GBTC_VULKAN_LOCAL_SIZE=64
GBTC_VULKAN_POLL_US=1000
GBTC_OPENCL_KERNEL=unrolled
GBTC_OPENCL_LOCAL_SIZE=64
GBTC_OPENCL_SIMD=auto
GBTC_OPENCL_POLL_US=1000
GBTC_BENCH_SECONDS=300
GBTC_BENCH_WARMUP_SECONDS=30
GBTC_VULKAN_WAIT_MODE=fence
GBTC_VULKAN_WAIT_US=10000
GBTC_GPU_QUEUE_MS=200
