#version 450
layout(constant_id = 0) const uint LOCAL_SIZE = 64;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

const uint CAPACITY = 1024u;

layout(push_constant) uniform PushConstants {
    uint midstate[8];
    uint tail3[3];
    uint nonce_base;
    uint target_word0;
    uint nonce_count;
} pc;

layout(set = 0, binding = 0) buffer OutputBuffer {
    uint count;
    uint candidates[CAPACITY];
} outbuf;

const uint K[64] = uint[64](
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
    0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
    0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
    0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
    0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
    0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
    0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
);

uint rotr(uint x, uint n) {
    return (x >> n) | (x << (32u - n));
}

void sha256_compress(inout uint state[8], uint w[16]) {
    uint wv[64];
    for (int i = 0; i < 16; i++) wv[i] = w[i];
    for (int i = 16; i < 64; i++) {
        uint s0 = rotr(wv[i - 15], 7u) ^ rotr(wv[i - 15], 18u) ^ (wv[i - 15] >> 3u);
        uint s1 = rotr(wv[i - 2], 17u) ^ rotr(wv[i - 2], 19u) ^ (wv[i - 2] >> 10u);
        wv[i] = wv[i - 16] + s0 + wv[i - 7] + s1;
    }
    uint a = state[0], b = state[1], c = state[2], d = state[3];
    uint e = state[4], f = state[5], g = state[6], h = state[7];
    for (int i = 0; i < 64; i++) {
        uint S1 = rotr(e, 6u) ^ rotr(e, 11u) ^ rotr(e, 25u);
        uint ch = (e & f) ^ (~e & g);
        uint t1 = h + S1 + ch + K[i] + wv[i];
        uint S0 = rotr(a, 2u) ^ rotr(a, 13u) ^ rotr(a, 22u);
        uint maj = (a & b) ^ (a & c) ^ (b & c);
        uint t2 = S0 + maj;
        h = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }
    state[0] += a; state[1] += b; state[2] += c; state[3] += d;
    state[4] += e; state[5] += f; state[6] += g; state[7] += h;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.nonce_count) return;
    uint nonce = pc.nonce_base + idx;

    uint state[8];
    for (int i = 0; i < 8; i++) state[i] = pc.midstate[i];

    uint w[16];
    w[0] = pc.tail3[0];
    w[1] = pc.tail3[1];
    w[2] = pc.tail3[2];
    w[3] = nonce;
    w[4] = 0x80000000u;
    for (int i = 5; i < 15; i++) w[i] = 0u;
    w[15] = 640u;

    sha256_compress(state, w);

    uint first[8];
    for (int i = 0; i < 8; i++) first[i] = state[i];

    state[0] = 0x6a09e667u; state[1] = 0xbb67ae85u;
    state[2] = 0x3c6ef372u; state[3] = 0xa54ff53au;
    state[4] = 0x510e527fu; state[5] = 0x9b05688cu;
    state[6] = 0x1f83d9abu; state[7] = 0x5be0cd19u;

    uint w2[16];
    for (int i = 0; i < 8; i++) w2[i] = first[i];
    w2[8] = 0x80000000u;
    for (int i = 9; i < 15; i++) w2[i] = 0u;
    w2[15] = 256u;

    sha256_compress(state, w2);

    uint final_word7 = state[7];
    uint bswapped = (final_word7 >> 24) | ((final_word7 >> 8) & 0x0000ff00u) |
                    ((final_word7 << 8) & 0x00ff0000u) | (final_word7 << 24);

    if (bswapped <= pc.target_word0) {
        uint slot = atomicAdd(outbuf.count, 1u);
        if (slot < CAPACITY) {
            outbuf.candidates[slot] = nonce;
        }
    }
}
